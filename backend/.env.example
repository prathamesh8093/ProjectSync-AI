# ==============================================================================
# ProjectSync AI - Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename the copy to '.env' in this folder (backend/.env)
#    or in the project root folder.
# 2. Replace the placeholder values below with your real development credentials.
# 3. NEVER commit your actual '.env' file or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. JWT Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (HMAC-SHA256).
# IMPORTANT: Must be at least 256 bits (minimum 32 characters/bytes in UTF-8).
# Example: Generate a secure random string or 64-character hex string.
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_min_256_bits

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Standard JDBC connection URL for Supabase PostgreSQL.
# In your Supabase dashboard: Project Settings -> Database -> Connection string (URI)
# Format: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?user=postgres&password=<your-password>
SUPABASE_DB_URL=jdbc:postgresql://<db-host>:5432/postgres?user=postgres&password=<your-database-password>

# ------------------------------------------------------------------------------
# 3. Supabase Storage Configuration
# ------------------------------------------------------------------------------
# Supabase service role secret key used for server-side storage operations.
# In your Supabase dashboard: Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

