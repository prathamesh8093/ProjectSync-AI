# ==============================================================================
# ProjectSync AI - Root Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root or in 'backend/.env' for local configuration.
# DO NOT commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# 1. Spring Profile (Choose: 'supabase' for cloud database, 'local' for offline H2 database)
SPRING_PROFILES_ACTIVE=supabase

# 2. Database Connection (Required when using Supabase cloud database)
# Default host: aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&connectTimeout=30&socketTimeout=60
SUPABASE_DB_USERNAME=postgres.htwzpyouqnkfnxuvbsot
SUPABASE_DB_PASSWORD=your_supabase_database_password_here

# 3. JWT Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=ProjectSyncAISecretKeyForJWTAuthentication2026Project

# 4. Gemini AI Configuration (Required for AI generation, grading, breakdown, and code inspection)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent

# 5. Supabase Storage Configuration (Required for Project File upload/download)
SUPABASE_STORAGE_URL=https://htwzpyouqnkfnxuvbsot.supabase.co
SUPABASE_STORAGE_BUCKET=project-files
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 6. VCS Module Storage
PROJECTSYNC_VCS_PATH=~/.projectsync/repositories
PROJECTSYNC_VCS_DEV_MODE=true
